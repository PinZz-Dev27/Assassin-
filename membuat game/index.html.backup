    <div id="modal-info" class="modal-overlay" style="z-index: 2000;">
        <div class="modal-box" style="min-width: 300px; padding: 25px;">
            <h2 id="info-judul" style="border: none; padding: 0; margin-bottom: 10px; font-size: 24px;">Info</h2>
            <p id="info-pesan" style="font-size: 16px; font-weight: 800; color: #cbd5e1; margin: 0;"></p>
        </div>
    </div>

    <script>
        let globalVolume = parseFloat(localStorage.getItem('volumeGame'));
        if (isNaN(globalVolume)) globalVolume = 1.0;
        let volSlider = document.getElementById('volume-slider');
        if (volSlider) {
            volSlider.value = globalVolume;
            volSlider.addEventListener('input', function () {ubahVolume(this.value);});
        }

        const AudioContextUI = window.AudioContext || window.webkitAudioContext;
        let actxUI;
        let masterGainUI;

        function inisialisasiAudioUI() {
            if (!actxUI) {
                try {
                    actxUI = new AudioContextUI();
                    masterGainUI = actxUI.createGain();
                    masterGainUI.connect(actxUI.destination);
                    masterGainUI.gain.value = globalVolume;
                } catch (e) {console.warn(e);}
            }
            if (actxUI && actxUI.state === 'suspended') actxUI.resume();
        }

        function playToneUI(type, f0, f1, dur, gVal = 0.1, isRamp = true) {
            if (globalVolume <= 0) return;
            inisialisasiAudioUI();
            if (!actxUI || !masterGainUI) return;
            let now = actxUI.currentTime, osc = actxUI.createOscillator(), g = actxUI.createGain();
            osc.type = type; osc.frequency.setValueAtTime(f0, now);
            if (f1 && f1 !== f0) {
                if (isRamp) osc.frequency.exponentialRampToValueAtTime(Math.max(10, f1), now + dur);
                else osc.frequency.setValueAtTime(f1, now + dur * 0.4);
            }
            g.gain.setValueAtTime(gVal, now); g.gain.linearRampToValueAtTime(0.001, now + dur);
            osc.connect(g); g.connect(masterGainUI); osc.start(now); osc.stop(now + dur);
        }

        function mainkanSuaraUI(jenis) {
            if (jenis === 'hover') playToneUI('sine', 450, 700, 0.04, 0.04);
            else if (jenis === 'open') playToneUI('triangle', 300, 450, 0.15, 0.1);
            else if (jenis === 'close') playToneUI('triangle', 450, 300, 0.15, 0.1);
            else if (jenis === 'error') playToneUI('sawtooth', 200, 150, 0.2, 0.15, false);
            else if (jenis === 'buy') playToneUI('square', 600, 1000, 0.2, 0.1, false);
            else if (jenis === 'start') playToneUI('sawtooth', 300, 800, 0.5, 0.2);
            else if (jenis === 'tada' && actxUI && masterGainUI) {
                [440, 660, 880].forEach((f, i) => {
                    let t = actxUI.currentTime + i * 0.15, o = actxUI.createOscillator(), g = actxUI.createGain();
                    o.type = 'sine'; o.frequency.setValueAtTime(f, t);
                    g.gain.setValueAtTime(0.2, t); g.gain.linearRampToValueAtTime(0.001, t + 0.6);
                    o.connect(g); g.connect(masterGainUI); o.start(t); o.stop(t + 0.6);
                });
            }
        }

        document.addEventListener('mouseover', (e) => {
            if (e.target.closest('button, .profile-card, .btn-map, .list-item, .btn-settings-icon')) {
                mainkanSuaraUI('hover');
            }
        });

        function ubahVolume(val) {
            globalVolume = parseFloat(val);
            localStorage.setItem('volumeGame', globalVolume);
            if (masterGainUI && actxUI) masterGainUI.gain.setValueAtTime(globalVolume, actxUI.currentTime);
        }

        let storedKoin = localStorage.getItem('koinPemain');
        let koinPemain = (storedKoin !== null && !isNaN(parseInt(storedKoin))) ? parseInt(storedKoin) : 8400;
        let levelTerbuka = parseInt(localStorage.getItem('unlockedLevel')) || 1;
        let namaPemain = localStorage.getItem('playerName') || 'Agent-X';
        document.getElementById("teks-koin").innerText = koinPemain;

        // RANK
        let totalKills = parseInt(localStorage.getItem('totalKills')) || 0;
        function getRankName() {
            if (totalKills >= 100) return "LEGEND";
            if (totalKills >= 50) return "SHADOW";
            if (totalKills >= 20) return "JONIN";
            if (totalKills >= 5) return "CHUNIN";
            return "GENIN";
        }
        document.getElementById("teks-rank").innerText = "RANK: " + getRankName();

        let cekUnlock = localStorage.getItem('justUnlocked');
        if (cekUnlock) {
            let mapName = (cekUnlock == 2) ? "🌲 Sector 2: Night Forest" : "🧪 Sector 3: Secret Lab";
            document.getElementById('teks-unlock-map').innerText = mapName;
            bukaModal('modal-unlock');
            setTimeout(() => mainkanSuaraUI('tada'), 500);
            localStorage.removeItem('justUnlocked');
        }

        function bukaModalPrestasi() {
            mainkanSuaraUI('open');
            let tk = parseInt(localStorage.getItem('totalKills')) || 0;
            let isGhost = localStorage.getItem('ach_ghost') === 'true';
            let isSpeed = localStorage.getItem('ach_speed') === 'true';
            let cG = localStorage.getItem('claim_ach_ghost') === 'true';
            let cS = localStorage.getItem('claim_ach_speed') === 'true';
            let cK = localStorage.getItem('claim_ach_kill') === 'true';

            let tGhost = {j: "👻 The Ghost", d: "Clear stage with 0 kills.", b: "Claim 3000 C"};
            let tSpeed = {j: "⚡ Lightning Strike", d: "Win under 25 seconds.", b: "Claim 2000 C"};
            let tKill = {j: "🩸 Reaper", d: `Eliminate 50 targets. (${tk}/50)`, b: "Claim 4000 C"};

            let htmlPrestasi = `
        <div class="list-item"><div><div style="font-weight: 900; color: var(--accent-gold); font-size: 16px;">${tGhost.j}</div><div style="font-size: 13px; color: #94a3b8;">${tGhost.d}</div></div><button class="opsi-btn btn-beli" ${cG ? 'disabled' : (isGhost ? '' : 'disabled')} onclick="klaimMisi('claim_ach_ghost', 3000, this, false)">${cG ? 'Claimed' : (isGhost ? tGhost.b : 'Locked')}</button></div>
        <div class="list-item"><div><div style="font-weight: 900; color: var(--accent-gold); font-size: 16px;">${tSpeed.j}</div><div style="font-size: 13px; color: #94a3b8;">${tSpeed.d}</div></div><button class="opsi-btn btn-beli" ${cS ? 'disabled' : (isSpeed ? '' : 'disabled')} onclick="klaimMisi('claim_ach_speed', 2000, this, false)">${cS ? 'Claimed' : (isSpeed ? tSpeed.b : 'Locked')}</button></div>
        <div class="list-item"><div><div style="font-weight: 900; color: var(--accent-gold); font-size: 16px;">${tKill.j}</div><div style="font-size: 13px; color: #94a3b8;">${tKill.d}</div></div><button class="opsi-btn btn-beli" ${cK ? 'disabled' : (tk >= 50 ? '' : 'disabled')} onclick="klaimMisi('claim_ach_kill', 4000, this, false)">${cK ? 'Claimed' : (tk >= 50 ? tKill.b : 'Locked')}</button></div>
      `;
            document.getElementById('prestasi-container').innerHTML = htmlPrestasi;
            document.getElementById('modal-prestasi').style.display = "flex";
        }

        function getDailyStats() {
            let tglHariIni = new Date().toLocaleDateString();
            let savedDate = localStorage.getItem('daily_quest_date');
            if (savedDate !== tglHariIni) {
                localStorage.setItem('daily_quest_date', tglHariIni);
                localStorage.setItem('daily_kills', '0');
                localStorage.setItem('daily_intel', '0');
                localStorage.setItem('daily_stages', '0');
                localStorage.setItem('daily_boss', '0');
            }
            return {
                kills: parseInt(localStorage.getItem('daily_kills')) || 0,
                intel: parseInt(localStorage.getItem('daily_intel')) || 0,
                stages: parseInt(localStorage.getItem('daily_stages')) || 0,
                boss: parseInt(localStorage.getItem('daily_boss')) || 0
            };
        }

        function bukaModalMisi() {
            mainkanSuaraUI('open');
            let tglHariIni = new Date().toLocaleDateString();
            let dStats = getDailyStats();

            // Status Klaim Hari Ini
            let cLogin = (localStorage.getItem('misi_claim_login') === tglHariIni);
            let cKills = (localStorage.getItem('misi_claim_kills') === tglHariIni);
            let cIntel = (localStorage.getItem('misi_claim_intel') === tglHariIni);
            let cStages = (localStorage.getItem('misi_claim_stages') === tglHariIni);
            let cBoss = (localStorage.getItem('misi_claim_boss') === tglHariIni);

            // 1. MISI LOGIN: Langsung bisa diklaim begitu login / buka menu
            let mLogin = {
                title: "🎁 Daily Check-in Protocol",
                desc: "Direct daily login reward. Ready to claim immediately!",
                reward: "+500 🪙 & +2 💎",
                ready: true,
                claimed: cLogin,
                btnText: cLogin ? "✓ Done" : "Claim Reward",
                id: "misi_claim_login",
                koin: 500,
                diamond: 2
            };

            // 2. MISI BUNUH MUSUH: Harus bunuh 15 musuh
            let kTarget = 15;
            let kCur = Math.min(kTarget, dStats.kills);
            let kReady = dStats.kills >= kTarget;
            let mKills = {
                title: "🩸 Target Elimination",
                desc: `Eliminate enemy operatives in combat. (${kCur}/${kTarget})`,
                reward: "+1000 🪙 & +3 💎",
                ready: kReady,
                claimed: cKills,
                btnText: cKills ? "✓ Done" : (kReady ? "Claim Reward" : `Locked (${kCur}/${kTarget})`),
                id: "misi_claim_kills",
                koin: 1000,
                diamond: 3
            };

            // 3. MISI DOKUMEN / INTEL: Ambil 5 dokumen
            let iTarget = 5;
            let iCur = Math.min(iTarget, dStats.intel);
            let iReady = dStats.intel >= iTarget;
            let mIntel = {
                title: "📂 Classified Intel Recovery",
                desc: `Collect secret documents scattered in sectors. (${iCur}/${iTarget})`,
                reward: "+1200 🪙 & +3 💎",
                ready: iReady,
                claimed: cIntel,
                btnText: cIntel ? "✓ Done" : (iReady ? "Claim Reward" : `Locked (${iCur}/${iTarget})`),
                id: "misi_claim_intel",
                koin: 1200,
                diamond: 3
            };

            // 4. MISI STAGE: Selesaikan 3 stage & escape
            let sTarget = 3;
            let sCur = Math.min(sTarget, dStats.stages);
            let sReady = dStats.stages >= sTarget;
            let mStages = {
                title: "🚁 Extraction Specialist",
                desc: `Successfully extract from missions via helipad. (${sCur}/${sTarget})`,
                reward: "+1500 🪙 & +4 💎",
                ready: sReady,
                claimed: cStages,
                btnText: cStages ? "✓ Done" : (sReady ? "Claim Reward" : `Locked (${sCur}/${sTarget})`),
                id: "misi_claim_stages",
                koin: 1500,
                diamond: 4
            };

            // 5. MISI BOSS: Kalahkan 1 Boss / Rival Assassin
            let bTarget = 1;
            let bCur = Math.min(bTarget, dStats.boss);
            let bReady = dStats.boss >= bTarget;
            let mBoss = {
                title: "👑 High-Value Target Execution",
                desc: `Assassinate a Sector Boss or Rival Assassin. (${bCur}/${bTarget})`,
                reward: "+2000 🪙 & +5 💎",
                ready: bReady,
                claimed: cBoss,
                btnText: cBoss ? "✓ Done" : (bReady ? "Claim Reward" : `Locked (${bCur}/${bTarget})`),
                id: "misi_claim_boss",
                koin: 2000,
                diamond: 5
            };

            let allMisi = [mLogin, mKills, mIntel, mStages, mBoss];

            let htmlMisi = allMisi.map(m => `
                <div class="list-item" style="display:flex; justify-content:space-between; align-items:center; background:rgba(30,41,59,0.7); border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:12px 16px; margin-bottom:10px;">
                    <div>
                        <div style="font-weight: 900; color: #10b981; font-size: 15px; display:flex; align-items:center; gap:8px;">
                            ${m.title}
                            <span style="font-size:11px; background:rgba(16,185,129,0.2); color:#34d399; padding:2px 7px; border-radius:10px; font-weight:700;">${m.reward}</span>
                        </div>
                        <div style="font-size: 13px; color: #94a3b8; margin-top:3px;">${m.desc}</div>
                    </div>
                    <button class="opsi-btn btn-beli" 
                        style="min-width:130px; font-size:13px; padding:8px 14px; font-weight:800; border-radius:8px;"
                        ${m.claimed || !m.ready ? 'disabled' : ''} 
                        onclick="klaimMisiHarian('${m.id}', ${m.koin}, ${m.diamond}, this)">
                        ${m.btnText}
                    </button>
                </div>
            `).join('');

            document.getElementById('misi-container').innerHTML = htmlMisi;
            document.getElementById('modal-misi').style.display = "flex";
        }

        function klaimMisiHarian(id, koin, diamond, btnEl) {
            mainkanSuaraUI('buy');
            koinPemain += koin;
            localStorage.setItem('koinPemain', koinPemain);
            document.getElementById("teks-koin").innerText = koinPemain;

            let curD = parseInt(localStorage.getItem('ninjaDiamonds')) || 0;
            curD += diamond;
            localStorage.setItem('ninjaDiamonds', curD);
            let dElem = document.getElementById("teks-diamond");
            if (dElem) dElem.innerText = curD;

            let tglHariIni = new Date().toLocaleDateString();
            localStorage.setItem(id, tglHariIni);

            btnEl.innerText = "✓ Done";
            btnEl.disabled = true;
            tampilkanInfo(`Reward Claimed: +${koin} Coins & +${diamond} Diamonds!`, "MISSION ACCOMPLISHED");
        }

        function klaimMisi(id, jumlah, btnEl, isDaily) {
            mainkanSuaraUI('buy');
            koinPemain += jumlah;
            localStorage.setItem('koinPemain', koinPemain);
            document.getElementById("teks-koin").innerText = koinPemain;
            if (isDaily) localStorage.setItem(id, new Date().toLocaleDateString());
            else localStorage.setItem(id, 'true');
            btnEl.innerText = "Done";
            btnEl.disabled = true;
            tampilkanInfo("Transferred " + jumlah + " C", "System");
        }

        function bukaModalNama() {
            mainkanSuaraUI('open');
            document.getElementById('input-nama').value = namaPemain;
            document.getElementById('modal-nama').style.display = 'flex';
        }

        function simpanNama() {
            let namaBaru = document.getElementById('input-nama').value;
            if (namaBaru && namaBaru.trim() !== "") {
                mainkanSuaraUI('buy');
                namaPemain = namaBaru.trim().substring(0, 15);
                localStorage.setItem('playerName', namaPemain);
                updateNamaUI();
                tutupModal('modal-nama');
                tampilkanInfo("Database Updated", "System");
            } else {
                mainkanSuaraUI('error');
                tampilkanInfo("Invalid Input!", "Error");
            }
        }

        function updateNamaUI() {
            document.getElementById("teks-profil").innerText = namaPemain;
        }

        // Change character image & glow color
        function aplikasikanWarnaGlow(hexColor) {
            let imgKarakter = document.getElementById("ninja-karakter");
            if (imgKarakter) {
                imgKarakter.style.filter = "drop-shadow(0 20px 20px rgba(0,0,0,0.75))";
            }
        }

        // Ensure throwing knives are unlocked from the start
        localStorage.setItem('item_shuriken', 'true');
        // Shadow Black (#111111) is the ONLY suit unlocked by default from the start
        localStorage.setItem('baju_hitam', 'true');

        let keyBajuMap = {
            '#111111': 'baju_hitam',
            '#2c3e50': 'baju_navy',
            '#ecf0f1': 'baju_putih',
            '#95a5a6': 'baju_abu',
            '#e74c3c': 'baju_merah',
            '#8e44ad': 'baju_ungu',
            '#f1c40f': 'baju_emas'
        };

        let warnaBaju = localStorage.getItem('ninjaColor') || '#111111';
        let checkKey = keyBajuMap[warnaBaju] || 'baju_hitam';
        if (checkKey !== 'baju_hitam' && localStorage.getItem(checkKey) !== 'true') {
            warnaBaju = '#111111';
            localStorage.setItem('ninjaColor', '#111111');
        }
        document.documentElement.style.setProperty('--ninja-color', warnaBaju);

        let imgKarakter = document.getElementById("ninja-karakter");
        if (imgKarakter) {
            if (warnaBaju === '#111111') imgKarakter.src = "hitam.png";
            else if (warnaBaju === '#2c3e50') imgKarakter.src = "navy.png";
            else if (warnaBaju === '#ecf0f1') imgKarakter.src = "putih.png";
            else if (warnaBaju === '#95a5a6') imgKarakter.src = "abu.png";
            else if (warnaBaju === '#e74c3c') imgKarakter.src = "merah.png";
            else if (warnaBaju === '#8e44ad') imgKarakter.src = "ungu.png";
            else if (warnaBaju === '#f1c40f') imgKarakter.src = "emas.png";
        }
        aplikasikanWarnaGlow(warnaBaju);

        function filterShopTab(cat, btn) {
            document.querySelectorAll('.shop-tab-btn').forEach(b => b.classList.remove('aktif'));
            if (btn) btn.classList.add('aktif');

            let cards = document.querySelectorAll('.shop-card');
            let visibleCount = 0;
            cards.forEach(card => {
                let cardKey = card.id.replace('shop-card-', '');
                let fullKey = card.getAttribute('data-kategori') === 'suit' ? ('baju_' + cardKey) : ('senjata_' + cardKey);
                let isOwned = localStorage.getItem(fullKey) === 'true';

                if (isOwned) {
                    card.style.display = 'none';
                    return;
                }

                if (cat === 'all' || card.getAttribute('data-kategori') === cat) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            let emptyMsg = document.getElementById('shop-empty-msg');
            if (emptyMsg) {
                emptyMsg.style.display = (visibleCount === 0) ? 'block' : 'none';
            }
        }

        function perbaruiShopUI() {
            let sCoins = document.getElementById('shop-coins-display');
            let sDiams = document.getElementById('shop-diamonds-display');
            if (sCoins) sCoins.innerText = koinPemain;
            if (sDiams) sDiams.innerText = localStorage.getItem('ninjaDiamonds') || '0';

            // Check owned status and hide purchased items from shop
            let cards = [
                {id: 'shop-card-navy', key: 'baju_navy', vault: 'card-suit-navy'},
                {id: 'shop-card-putih', key: 'baju_putih', vault: 'card-suit-putih'},
                {id: 'shop-card-abu', key: 'baju_abu', vault: 'card-suit-abu'},
                {id: 'shop-card-merah', key: 'baju_merah', vault: 'card-suit-merah'},
                {id: 'shop-card-ungu', key: 'baju_ungu', vault: 'card-suit-ungu'},
                {id: 'shop-card-emas', key: 'baju_emas', vault: 'card-suit-emas'},
                {id: 'shop-card-katana', key: 'senjata_katana', vault: 'vault-katana'},
                {id: 'shop-card-karambit', key: 'senjata_karambit', vault: 'vault-karambit'},
                {id: 'shop-card-saber', key: 'senjata_saber', vault: 'vault-saber'}
            ];

            let activeCount = 0;
            cards.forEach(item => {
                let el = document.getElementById(item.id);
                let vEl = document.getElementById(item.vault);
                let isOwned = localStorage.getItem(item.key) === 'true';

                if (isOwned) {
                    if (el) el.style.display = 'none';
                    if (vEl) vEl.style.display = 'flex';
                } else {
                    if (el) {
                        el.style.display = 'flex';
                        activeCount++;
                    }
                }
            });

            let emptyMsg = document.getElementById('shop-empty-msg');
            if (emptyMsg) {
                emptyMsg.style.display = (activeCount === 0) ? 'block' : 'none';
            }
        }

        function perbaruiSkillUI() {
            let sDiams = document.getElementById('skill-diamonds-display');
            let currentDiamonds = parseInt(localStorage.getItem('ninjaDiamonds')) || 0;
            if (sDiams) sDiams.innerText = currentDiamonds;

            let skills = [
                {key: 'skill_ghost', btn: 'btn-buy-ghost'},
                {key: 'skill_blink', btn: 'btn-buy-blink'},
                {key: 'skill_time', btn: 'btn-buy-time'},
                {key: 'skill_clone', btn: 'btn-buy-clone'}
            ];

            skills.forEach(s => {
                let b = document.getElementById(s.btn);
                if (b) {
                    if (localStorage.getItem(s.key) === 'true') {
                        b.innerText = "✓ UNLOCKED";
                        b.disabled = true;
                        b.style.borderColor = "#22c55e";
                        b.style.color = "#4ade80";
                        b.style.background = "rgba(34, 197, 94, 0.15)";
                    }
                }
            });
        }

        function beliSkill(skillKey, costDiamond, cardId) {
            let currentDiamonds = parseInt(localStorage.getItem('ninjaDiamonds')) || 0;
            if (currentDiamonds >= costDiamond) {
                mainkanSuaraUI('buy');
                currentDiamonds -= costDiamond;
                localStorage.setItem('ninjaDiamonds', currentDiamonds);
                localStorage.setItem(skillKey, 'true');

                document.getElementById('teks-diamond').innerText = currentDiamonds;
                perbaruiSkillUI();
                tampilkanInfo("Skill Protocol Unlocked!", "SYSTEM");
            } else {
                mainkanSuaraUI('error');
                tampilkanInfo("Need " + costDiamond + " 💎! Insufficient Diamonds.", "Error");
            }
        }

        function beliItem(kunciId, harga, mataUang, idVault, idShopCard) {
            if (kunciId && kunciId.startsWith('senjata_')) {
                mainkanSuaraUI('error');
                tampilkanInfo("Senjata ini terkunci di versi Demo game! Akan tersedia di rilis penuh.", "DEMO VERSION");
                return;
            }
            let success = false;
            let currentDiamonds = parseInt(localStorage.getItem('ninjaDiamonds')) || 0;

            if (mataUang === 'diamond') {
                if (currentDiamonds >= harga) {
                    currentDiamonds -= harga;
                    localStorage.setItem('ninjaDiamonds', currentDiamonds);
                    document.getElementById("teks-diamond").innerText = currentDiamonds;
                    let sd = document.getElementById('shop-diamonds-display');
                    if (sd) sd.innerText = currentDiamonds;
                    success = true;
                } else {
                    mainkanSuaraUI('error');
                    tampilkanInfo("Need " + harga + " 💎! Insufficient Diamonds.", "Error");
                    return;
                }
            } else {
                if (koinPemain >= harga) {
                    koinPemain -= harga;
                    localStorage.setItem('koinPemain', koinPemain);
                    document.getElementById("teks-koin").innerText = koinPemain;
                    let sc = document.getElementById('shop-coins-display');
                    if (sc) sc.innerText = koinPemain;
                    success = true;
                } else {
                    mainkanSuaraUI('error');
                    tampilkanInfo("Need " + harga + " C! Insufficient Coins.", "Error");
                    return;
                }
            }

            if (success) {
                mainkanSuaraUI('buy');
                localStorage.setItem(kunciId, 'true');

                // Animate card vanishing
                let shopCard = document.getElementById(idShopCard);
                if (shopCard) {
                    shopCard.classList.add('vanished');
                    setTimeout(() => {
                        shopCard.style.display = 'none';
                        perbaruiShopUI();
                    }, 350);
                }

                let vEl = document.getElementById(idVault);
                if (vEl) vEl.style.display = 'flex';

                perbaruiEquippedUI();
                tampilkanInfo("Asset Acquired! Stored in Armory.", "PURCHASED");
            }
        }

        function perbaruiEquippedUI() {
            let currentBaju = localStorage.getItem('ninjaColor') || '#111111';
            let currentSenjata = localStorage.getItem('weaponType') || 'bentuk-kayu';

            // Sync Diamond Counter
            let dElem = document.getElementById('teks-diamond');
            if (dElem) dElem.innerText = localStorage.getItem('ninjaDiamonds') || '0';

            // 7 SUITS: Hitam (Default Owned), Navy, Gold, Abu, Ungu, Merah, Putih (Must be bought)
            let bajus = [
                {btnId: 'btn-vault-hitam', cardId: 'card-suit-hitam', color: '#111111', key: 'baju_hitam'},
                {btnId: 'btn-vault-navy', cardId: 'card-suit-navy', color: '#2c3e50', key: 'baju_navy'},
                {btnId: 'btn-vault-emas', cardId: 'card-suit-emas', color: '#f1c40f', key: 'baju_emas'},
                {btnId: 'btn-vault-abu', cardId: 'card-suit-abu', color: '#95a5a6', key: 'baju_abu'},
                {btnId: 'btn-vault-ungu', cardId: 'card-suit-ungu', color: '#8e44ad', key: 'baju_ungu'},
                {btnId: 'btn-vault-merah', cardId: 'card-suit-merah', color: '#e74c3c', key: 'baju_merah'},
                {btnId: 'btn-vault-putih', cardId: 'card-suit-putih', color: '#ecf0f1', key: 'baju_putih'}
            ];
            bajus.forEach(b => {
                let btn = document.getElementById(b.btnId);
                let card = document.getElementById(b.cardId);
                let isOwned = (b.key === 'baju_hitam') || (localStorage.getItem(b.key) === 'true');
                let isEquipped = isOwned && (b.color.toLowerCase() === currentBaju.toLowerCase());

                if (btn) {
                    if (!isOwned) {
                        btn.innerText = "🔒 LOCKED";
                        btn.style.opacity = "0.6";
                        btn.style.background = "rgba(100, 116, 139, 0.4)";
                        btn.style.color = "#94a3b8";
                        btn.style.cursor = "not-allowed";
                    } else if (isEquipped) {
                        btn.innerText = "✓ EQUIPPED";
                        btn.style.opacity = "1";
                        btn.style.background = "#22c55e";
                        btn.style.color = "#ffffff";
                        btn.style.cursor = "default";
                    } else {
                        btn.innerText = "EQUIP";
                        btn.style.opacity = "1";
                        btn.style.background = "";
                        btn.style.color = "";
                        btn.style.cursor = "pointer";
                    }
                }
                if (card) {
                    if (isEquipped) {
                        card.classList.add('terpilih');
                    } else {
                        card.classList.remove('terpilih');
                    }
                    if (!isOwned) {
                        card.style.opacity = "0.7";
                        card.style.filter = "grayscale(0.6)";
                    } else {
                        card.style.opacity = "1";
                        card.style.filter = "none";
                    }
                }
            });

            let senjatas = [
                {id: 'btn-senjata-kayu', type: 'bentuk-kayu'},
                {id: 'btn-senjata-katana', type: 'bentuk-katana'},
                {id: 'btn-senjata-karambit', type: 'bentuk-karambit'},
                {id: 'btn-senjata-saber', type: 'bentuk-saber'}
            ];
            senjatas.forEach(s => {
                let el = document.getElementById(s.id);
                if (el) {
                    if (s.type === currentSenjata) {el.innerText = "✓ EQUIPPED"; el.classList.add('terpilih');}
                    else {el.innerText = "EQUIP"; el.classList.remove('terpilih');}
                }
            });
        }

        function perbaruiTampilanMap() {
            let card2 = document.getElementById('card-sector-2');
            let card3 = document.getElementById('card-sector-3');
            let lock2 = document.getElementById('lock-overlay-2');
            let lock3 = document.getElementById('lock-overlay-3');
            let pill2 = document.getElementById('status-pill-2');
            let pill3 = document.getElementById('status-pill-3');

            // Count stars earned
            function getStarsForLevel(lvl) {
                let s1 = parseInt(localStorage.getItem('stars_' + lvl + '_1')) || 0;
                let s2 = parseInt(localStorage.getItem('stars_' + lvl + '_2')) || 0;
                let s3 = parseInt(localStorage.getItem('stars_' + lvl + '_3')) || 0;
                let maxS = Math.max(s1, s2, s3);
                if (maxS >= 3) return "⭐⭐⭐";
                if (maxS === 2) return "⭐⭐☆";
                if (maxS === 1) return "⭐☆☆";
                return "☆☆☆";
            }

            let s1Elem = document.getElementById('stars-sector-1');
            let s2Elem = document.getElementById('stars-sector-2');
            let s3Elem = document.getElementById('stars-sector-3');
            if (s1Elem) s1Elem.innerText = getStarsForLevel(1);
            if (s2Elem) s2Elem.innerText = getStarsForLevel(2);
            if (s3Elem) s3Elem.innerText = getStarsForLevel(3);

            if (levelTerbuka < 2) {
                if (card2) card2.classList.add('locked');
                if (lock2) lock2.style.display = 'flex';
                if (pill2) {pill2.innerText = "LOCKED"; pill2.classList.remove('status-ready');}
            } else {
                if (card2) card2.classList.remove('locked');
                if (lock2) lock2.style.display = 'none';
                if (pill2) {pill2.innerText = "UNLOCKED — READY"; pill2.classList.add('status-ready');}
            }

            if (levelTerbuka < 3) {
                if (card3) card3.classList.add('locked');
                if (lock3) lock3.style.display = 'flex';
                if (pill3) {pill3.innerText = "LOCKED"; pill3.classList.remove('status-ready');}
            } else {
                if (card3) card3.classList.remove('locked');
                if (lock3) lock3.style.display = 'none';
                if (pill3) {pill3.innerText = "UNLOCKED — READY"; pill3.classList.add('status-ready');}
            }
        }

        function resetGameData() {
            mainkanSuaraUI('error');
            if (confirm("Wipe all system data? This cannot be undone.")) {
                localStorage.clear();
                location.reload();
            }
        }

        function bukaModal(id) {
            mainkanSuaraUI('open');
            if (id === 'modal-vault' || id === 'modal-senjata') perbaruiEquippedUI();
            if (id === 'modal-pilih-map') perbaruiTampilanMap();
            if (id === 'modal-shop') perbaruiShopUI();
            if (id === 'modal-skill') perbaruiSkillUI();
            document.getElementById(id).style.display = "flex";
        }

        function tutupModal(id) {
            mainkanSuaraUI('close');
            let modal = document.getElementById(id);
            modal.style.animation = "none";
            setTimeout(() => {
                modal.style.display = "none";
                modal.style.animation = "modalFade 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards";
            }, 10);
        }

        function tampilkanInfo(psn, jdl) {
            document.getElementById("info-judul").innerText = jdl;
            document.getElementById("info-pesan").innerText = psn;
            document.getElementById("modal-info").style.display = "flex";
            setTimeout(() => {tutupModal('modal-info');}, 1500);
        }

        // Equip suit & change character image (7 suits supported)
        function gantiBaju(c) {
            let keyBajuMap = {
                '#111111': 'baju_hitam',
                '#2c3e50': 'baju_navy',
                '#ecf0f1': 'baju_putih',
                '#95a5a6': 'baju_abu',
                '#e74c3c': 'baju_merah',
                '#8e44ad': 'baju_ungu',
                '#f1c40f': 'baju_emas'
            };
            let suitKey = keyBajuMap[c] || 'baju_hitam';
            if (suitKey !== 'baju_hitam' && localStorage.getItem(suitKey) !== 'true') {
                mainkanSuaraUI('error');
                tampilkanInfo("Baju ini masih terkunci! Silakan beli di Shop terlebih dahulu.", "SUIT LOCKED");
                return;
            }

            mainkanSuaraUI('buy');
            document.documentElement.style.setProperty('--ninja-color', c);
            localStorage.setItem('ninjaColor', c);

            let imgKarakter = document.getElementById("ninja-karakter");
            if (imgKarakter) {
                if (c === '#111111') imgKarakter.src = "hitam.png";
                else if (c === '#2c3e50') imgKarakter.src = "navy.png";
                else if (c === '#ecf0f1') imgKarakter.src = "putih.png";
                else if (c === '#95a5a6') imgKarakter.src = "abu.png";
                else if (c === '#e74c3c') imgKarakter.src = "merah.png";
                else if (c === '#8e44ad') imgKarakter.src = "ungu.png";
                else if (c === '#f1c40f') imgKarakter.src = "emas.png";
            }

            aplikasikanWarnaGlow(c);
            perbaruiEquippedUI();
            tutupModal('modal-vault');
            tampilkanInfo("Operative Suit Equipped!", "ARMORY");
        }

        function gantiSenjata(t, c) {
            if (t !== 'bentuk-kayu') {
                mainkanSuaraUI('error');
                tampilkanInfo("Senjata ini terkunci di versi Demo game!", "DEMO VERSION");
                return;
            }
            mainkanSuaraUI('buy');
            localStorage.setItem('weaponType', t);
            localStorage.setItem('weaponColor', c);
            perbaruiEquippedUI();
            tutupModal('modal-senjata');
        }

        function gasMain(lvl, mapId) {
            if (lvl > levelTerbuka) {
                mainkanSuaraUI('error');
                return;
            }
            mainkanSuaraUI('start');
            localStorage.setItem('selectedMap', mapId);
            localStorage.setItem('selectedLevel', lvl);
            tutupModal('modal-pilih-map');
            tampilkanInfo("Initializing Mission...", "SYSTEM");
            setTimeout(() => {window.location.href = "game.html";}, 1000);
        }

        updateNamaUI();
        perbaruiEquippedUI();
        perbaruiShopUI();
        perbaruiSkillUI();
    </script>
</body>

</html>